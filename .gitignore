# @tags git,ignore,security

# 环境变量（所有.env文件均不提交远程，但保留.env.example作为模板）
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 日志
*.log
logs/

# 数据
data/
*.db
*.sqlite

# 证书
traefik/acme.json

# WireGuard 私钥（绝对不可提交远程）
*.key
core/config/keys/

# 覆盖率报告
.coverage
htmlcov/
.coverage.*

# 设备模型文档（含大文件模型权重，不提交远程仓库）
docs/YYC3-设备-模型/

# 团队规范中的大文件（提示词模板等，按需提交）
docs/团队规范/标规文档/YYC3-闭环验收提示词.md
# docs/ 其余文档已纳入版本控制

# 临时文件
*.tmp
.tmp_*
*.temp
.DS_Store

# Cypress/Playwright 测试产物
tests/e2e/cypress/screenshots/
tests/e2e/cypress/videos/
tests/e2e/reports/
tests/e2e/playwright-report/
tests/e2e/test-results/

# GitHub Workflows (需要手动管理以避免 OAuth 权限问题)
.github/workflows/*.yml
