# =============================================
# YYC³ NAS Gateway 环境变量模板
# 使用: 复制为 /Volume2/yyc3-33/.env 并填写真实值
# 安全: 切勿将真实凭据提交到代码仓库！
# 由 scripts/deploy-nas-gateway.sh 自动检测并引导
# =============================================

# ----- PostgreSQL -----
POSTGRES_PASSWORD=CHANGE_ME_STRONG
REPLICATOR_PASSWORD=CHANGE_ME_STRONG
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG
DB_NAME=yyc3_gpt

# ----- Redis -----
REDIS_PASSWORD=CHANGE_ME_STRONG
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ZHIPU_API_KEY=CHANGE_ME_ZHIPU_KEY
OPENAI_API_KEY=sk-CHANGE_ME_OPENAI
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
API_KEYS=sk-CHANGE_ME_API_KEY

# ----- 网络 -----
HOST_IP=10.200.0.4
HOST_IP_SUFFIX=4

# ----- A2A 协同事务（Phase 5 灰度；缺省全开，见 docker-compose.nas.yml） -----
# A2A_ENABLED=true
# A2A_RESULT_CONSUMER_ENABLED=true
# A2A_AUDIT_LOKI_ENABLED=true          # 审计流 shipper 开闸（需监控栈 Loki：yyc3-loki）
# LOKI_URL=http://yyc3-loki:3100
# A2A_WORKER_AGENTS=yushu-wanwu-001,yujian-xianzhi-001,chuangxiang-lingyun-001,gewu-zongshi-001,yanqi-qianhang-001

# ----- 日志 -----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----- 管理与路由（2026-09-27 补齐：对齐生产 /Volume2/yyc3-33/.env 实际键集） -----
ADMIN_API_KEYS=            # 管理端密钥，逗号分隔（留空=未启用管理面）
API_KEYS=sk-CHANGE_ME_API_KEY
CORS_ORIGINS=              # 逗号分隔白名单；留空=同源策略
MAX_REQUEST_SIZE=          # 请求体上限（如 50mb）
OPENAI_COMPATIBLE_UPSTREAMS=  # OpenAI 兼容上游列表（JSON/逗号分隔，见 core 文档）
ROUTER_ENABLED=true        # 模型路由开关

# ----- 监控栈（docker-compose.monitoring.yml） -----
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA   # yyc3-grafana 初始管理员口令

# ----- WireGuard 组网（gateway 侧声明的 WG 身份；集群 WG 详见核心文档 00 号） -----
WG_INTERFACE=
WG_PRIVATE_KEY=
WG_PUBLIC_KEY=
WG_ADDRESS=
WG_DNS=
WG_PORT=
WG_PEER_ENDPOINT=
WG_PEER_PUBLIC_KEY=
