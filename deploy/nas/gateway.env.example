# =============================================
# YYC³ NAS Gateway 环境变量模板
# 使用: 复制为 /Volume2/yyc3-33/.env 并填写真实值
# 安全: 切勿将真实凭据提交到代码仓库！
# 由 scripts/deploy-nas-gateway.sh 自动检测并引导
# =============================================

# ----- PostgreSQL -----
POSTGRES_PASSWORD=CHANGE_ME_STRONG
REPLICATOR_PASSWORD=CHANGE_ME_STRONG
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG
DB_NAME=yyc3_gpt

# ----- Redis -----
REDIS_PASSWORD=CHANGE_ME_STRONG
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ZHIPU_API_KEY=CHANGE_ME_ZHIPU_KEY
OPENAI_API_KEY=sk-CHANGE_ME_OPENAI
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
API_KEYS=sk-CHANGE_ME_API_KEY

# ----- 网络 -----
HOST_IP=10.200.0.4
HOST_IP_SUFFIX=4

# ----- A2A 协同事务（Phase 5 灰度；缺省全开，见 docker-compose.nas.yml） -----
# A2A_ENABLED=true
# A2A_RESULT_CONSUMER_ENABLED=true
# A2A_AUDIT_LOKI_ENABLED=true          # 审计流 shipper 开闸（需监控栈 Loki：yyc3-loki）
# LOKI_URL=http://yyc3-loki:3100
# A2A_WORKER_AGENTS=yushu-wanwu-001,yujian-xianzhi-001,chuangxiang-lingyun-001,gewu-zongshi-001,yanqi-qianhang-001

# ----- 日志 -----
LOG_LEVEL=INFO
LOG_FORMAT=json
