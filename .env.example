# @file .env.example
# @description YYC³ 环境变量配置主模板
# @author YanYuCloudCube Team <admin@0379.email>
# @version v2.1.0
# @created 2026-03-14 | @updated 2026-09-23
# @status stable | @license MIT
# ============================================================
# 使用方式: cp .env.example .env 并填入实际值（生产密钥绝不可提交到 Git）
# 完整变量清单详见: docs/YYC3-全局全链路综合总结报告.md
# ============================================================

# ════════════════════════════════════════════════════════════
# 一、基础配置
# ════════════════════════════════════════════════════════════
ENVIRONMENT=production
# 可选值: production / development / staging

# ── 网络标识 ──────────────────────────────────────────────
# 【硬件角色】
#   模型部署主阵地:  yyc3-101(100.65.64.49) + yyc3-102(100.76.167.103) — DGX GB10 双机，Ollama GPU
#   API网关+存储:    yyc3-45(100.65.172.88) — NAS，运行 Gateway v5 + PG + Redis + NFS
#   公网入口:        yyc3-33(39.97.53.176) — 阿里云ECS，Traefik + 监控
#   代码中心:        yyc3-22(100.87.159.21) — MacMax，开发机 + SSH枢纽
#   【注意】所有节点通过 Tailscale VPN 组网，原 WireGuard 已不再使用
HOST_IP=<YOUR_TAILSCALE_IP_OR_LAN_IP>
# 【占位说明】填写本机在 Tailscale 中的 IP 地址，如 100.87.159.21

HOST_IP_SUFFIX=<NODE_ID>
# 【占位说明】节点标识后缀，用于 Patroni 命名，如 22/45/33/101/102

# ════════════════════════════════════════════════════════════
# 二、数据库配置
# ════════════════════════════════════════════════════════════
# Docker 内部: DB_HOST=postgres
# NAS 宿主机直连: DB_HOST=127.0.0.1
DB_HOST=<DB_HOST>
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<STRONG_PASSWORD>
# 【占位说明】生产环境请用 openssl rand -base64 32 生成强密码

DB_NAME=yyc3_gpt

# PostgreSQL 复制密码（Patroni HA 使用）
REPLICATOR_PASSWORD=<REPLICATOR_PASSWORD>

# ════════════════════════════════════════════════════════════
# 三、Redis 缓存配置
# ════════════════════════════════════════════════════════════
# Docker 内部: REDIS_HOST=redis
# NAS 宿主机直连: REDIS_HOST=127.0.0.1
REDIS_HOST=<REDIS_HOST>
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 【占位说明】NAS 宿主机 Redis 当前无密码，留空即可。
#             生产环境建议设置密码：requirepass <password>

# ════════════════════════════════════════════════════════════
# 四、模型服务配置
# ════════════════════════════════════════════════════════════
# ● Ollama 本地模型
# 【注意】模型部署主阵地在 DGX GB10 双机（yyc3-101/102）
#   Gateway 调用 Ollama 时，OLLAMA_HOST 应指向 DGX Tailscale IP
#   MacMax/Ollama CPU 仅用于轻量推理或开发调试
OLLAMA_HOST=100.65.64.49
# 【占位】生产环境指向 DGX-101 (100.65.64.49) 或 DGX-102 (100.76.167.103)
#        本地调试用 host.docker.internal (Docker for Mac) 或 localhost (Linux)
OLLAMA_PORT=11434
OLLAMA_MODELS=/mnt/models

# ● 智谱 AI（当前已过期，需重新申请）
ZHIPU_API_KEY=<YOUR_ZHIPU_API_KEY>
# 【占位说明】格式: <32位hex>.<16位随机字符串>
#             申请地址: https://open.bigmodel.cn/

# ● OpenAI（可选）
OPENAI_API_KEY=
# 【占位说明】格式: sk-<48位hex>。留空=不启用

# ● DeepSeek（可选）
DEEPSEEK_API_KEY=
# 【占位说明】格式: sk-<32位hex>。留空=不启用

# ════════════════════════════════════════════════════════════
# 五、认证与安全配置
# ════════════════════════════════════════════════════════════
# 【生产必填】JWT 签名密钥，用于生成 API Token
JWT_SECRET_KEY=<GENERATE: openssl rand -base64 64>
# 【占位说明】生产环境务必执行：openssl rand -base64 64

# JWT 算法和过期时间
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# 【生产必填】API 访问密钥列表（逗号分隔，支持多个轮换）
API_KEYS=<API_KEY_1>,<API_KEY_2>
# 【占位说明】示例: sk-yyc3-prod-key-001,sk-yyc3-prod-key-002

# 【推荐】管理面密钥（/v1/admin/** 鉴权；逗号分隔）
ADMIN_API_KEYS=<ADMIN_KEY_1>
# 【占位说明】vk 看板等管理端使用。留空 = 回退 API_KEYS（兼容单机部署）；
#             生产环境建议与 API_KEYS 分离，实现推理面/管理面最小权限

# 是否启用 API 认证（生产务必为 true）
AUTH_ENABLED=true

# CORS 跨域白名单（逗号分隔）
ALLOWED_ORIGINS=https://api.0379.world

# ════════════════════════════════════════════════════════════
# 六、Traefik / 反向代理配置
# ════════════════════════════════════════════════════════════
LETSENCRYPT_EMAIL=admin@0379.world
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=<STRONG_PASSWORD>
BASIC_AUTH_HASH=<GENERATE: htpasswd -nbB admin $BASIC_AUTH_PASSWORD>
# 【占位说明】执行 htpasswd -nbB admin "<password>" 生成

CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_TOKEN>
# 【占位说明】从 Cloudflare Dashboard → API Tokens 获取

# ════════════════════════════════════════════════════════════
# 七、监控配置
# ════════════════════════════════════════════════════════════
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ════════════════════════════════════════════════════════════
# 八、API 服务配置
# ════════════════════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_LOG_LEVEL=info

# ════════════════════════════════════════════════════════════
# ⚠️ 安全提醒
# ════════════════════════════════════════════════════════════
# 1. 本文件仅为模板，.env 文件必须加入 .gitignore
# 2. 生产密钥（JWT_SECRET_KEY, API_KEYS, 数据库密码）务必使用强随机串
# 3. GitHub Secrets 中的密钥为 CI/CD 唯一来源
# 4. 当前 ZHIPU_API_KEY 已过期（返回 401），需在智谱平台重新申请
# 5. OLLAMA_HOST 生产环境应指向 DGX GB10 Tailscale IP（默认 100.65.64.49）
# 6. HOST_IP 系列变量在原设计中用于 WireGuard，当前实际使用 Tailscale

# ═══ 上游池（详见 core/config/.env.example 完整说明）═════════
ROUTER_ENABLED=true
# 单行 JSON 示例（旗舰 vLLM + N2 Ollama）：
# OPENAI_COMPATIBLE_UPSTREAMS=[{"name":"flagship-dsv4","base_url":"http://100.65.64.49:8001","fallback_url":"http://10.100.168.2:8001","models":["deepseek-v4-flash","deepseek-v4*"],"priority":1,"weight":100,"capacity":32}]
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BACKUP_HOST=

# ════════════════════════════════════════════════════════════
# 九、AI Family Agent 配置（core/agents，Phase 0）
# ════════════════════════════════════════════════════════════
# 【占位说明】LLM 服务地址（OpenAI 兼容 /chat/completions）。
#             留空 = 显式 Mock 模式（离线调试/单元测试零网络依赖，调用自动降级兜底）。
#             生产建议指向网关自身或 DGX NIM 直连（可行性报告适配点 A1）。
LLM_BASE_URL=
LLM_API_KEY=
# 【占位说明】默认旗舰模型；各 Agent 角色-模型映射表详见
#             docs/0379-world-yyc3-expert-20260925/00-多Agent协同架构可行性论证报告.md
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
# 角色→模型映射表（JSON，按 Agent 人格化名称匹配；命中走 upstream_registry 通配规则，
# 未命中的 Agent 回退 LLM_MODEL）。指向网关自身时即获熔断/EWMA/vk 计费全量能力（适配点 A1）。
# 示例：{"元启·天枢": "deepseek-v4-pro", "言启·千行": "nemotron-mini-4b", "预见先知": "deepseek-v4-flash"}
AGENT_MODEL_MAPPING=
# 内置编排 Worker（认领 agent:queue 执行九步管线；外置 Worker 部署时置 false，改走 /v1/admin/agent/tasks/claim）
AGENT_WORKER_ENABLED=true
# A2A 协议（Phase 2）：审计 sink 注入 + 内置编队 Agent Card 注册/心跳（30s 周期写入
# a2a:agent:registry，90s 超时离线；能力发现 GET /v1/a2a/agents）。独立注册中心部署时置 false。
A2A_ENABLED=true
# 业务 Agent 外置 Worker（Phase 2 A2A Worker 化）：独立进程消费 stream:agent:task:{agent_id}
#（消费者组 + ACK + 3 次重试 + DLQ）。启动：python core/scripts/agent_worker.py；
# 本清单仅约束该进程消费哪些 Agent（首批语枢/预见/创想 + 扩面格物/演启共 5 编队成员），网关进程不读取。
A2A_WORKER_AGENTS=yushu-wanwu-001,yujian-xianzhi-001,chuangxiang-lingyun-001,gewu-zongshi-001,yanqi-qianhang-001
# 消费者名后缀（缺省 hostname-pid；多进程/多机部署各自唯一，避免投递记录混淆）
A2A_WORKER_CONSUMER=
# 审计流 Loki 消费端：网关内嵌 shipper 消费 stream:audit:log（孤儿/死信/重试审计）
# 批量推送 Loki /loki/api/v1/push（labels job=a2a-audit/event/agent）。缺省 false；
# 启用需 compose.full 监控栈（Loki 2.9.2 :3100）或外部 Loki（LOKI_URL 指向）。
A2A_AUDIT_LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
# 审计 shipper 消费者名后缀（缺省 hostname-pid）
A2A_AUDIT_CONSUMER=
# 结果流消费端（Phase 2 编排器聚合）：网关内嵌泵消费 stream:agent:result:callback
#（wait_one 请求-响应闭环 + XAUTOCLAIM 挂起回收）；A2A_ENABLED 关闭时同步关闭，
# 独立编排器部署时在网关侧置 false
A2A_RESULT_CONSUMER_ENABLED=true
# 结果流消费者名后缀（缺省 hostname-pid；多网关实例部署各自唯一）
A2A_RESULT_CONSUMER=
