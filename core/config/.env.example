# @file .env.example (core/config/)
# @description YYC³ 核心配置环境变量示例（与根目录同步维护）
# @version v2.0.0 | @updated 2026-07-27
# ============================================================
# 完整变量清单及释义详见: docs/YYC3-全局全链路综合总结报告.md
# ============================================================

# ═══ 基础 ═══════════════════════════════════════════════════
ENVIRONMENT=production
HOST_IP=<YOUR_TAILSCALE_IP>
# 【占位】实际为 Tailscale IP，如 100.65.172.88 (NAS)
HOST_IP_SUFFIX=<NODE_ID>
# 【占位】节点编号：22/45/33/101/102

# ═══ 数据库 ═════════════════════════════════════════════════
DB_HOST=<DB_HOST>
# 【占位】Docker环境=postgres，NAS宿主机=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<STRONG_PASSWORD>
DB_NAME=yyc3_gpt

POSTGRES_PASSWORD=<STRONG_PASSWORD>
REPLICATOR_PASSWORD=<STRONG_PASSWORD>

# ═══ Redis ═══════════════════════════════════════════════════
REDIS_HOST=<REDIS_HOST>
# 【占位】Docker环境=redis，NAS宿主机=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 【占位】NAS Redis 无密码，留空

# ═══ Ollama ═════════════════════════════════════════════════
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11435
# 【注意】端口已从 11434 变更为 11435
OLLAMA_MODELS=/mnt/models

# ═══ API Keys ═══════════════════════════════════════════════
OPENAI_API_KEY=
# 【占位】可选，留空=不启用
ZHIPU_API_KEY=<YOUR_ZHIPU_API_KEY>
# 【占位】当前已过期 401，需重新申请
DEEPSEEK_API_KEY=
# 【占位】可选，留空=不启用

# ═══ 认证 ═══════════════════════════════════════════════════
JWT_SECRET_KEY=<GENERATE: openssl rand -base64 64>
API_KEYS=<API_KEY_1>,<API_KEY_2>
AUTH_ENABLED=true
ALLOWED_ORIGINS=https://api.0379.world

# ═══ Traefik ════════════════════════════════════════════════
LETSENCRYPT_EMAIL=admin@0379.world
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=<STRONG_PASSWORD>
BASIC_AUTH_HASH=<GENERATE: htpasswd -nbB admin $BASIC_AUTH_PASSWORD>
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_TOKEN>

# ═══ 监控 ═══════════════════════════════════════════════════
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
