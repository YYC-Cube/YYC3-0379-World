# YYC³ 生产环境配置文件
# 文件: .env.production
# 说明: 生产环境专用配置

# ==================== 数据库配置 ====================
# 2026-09-27 修正（依据《YYC3-数据库统一架构-2026-09》05 号错配表）：
# ECS 生产库为本机 PG16，实际监听 5433（原 5432 为错配）；生产原则=本机回环，不跨公网连内网库
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=yyc3_gpt
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==================== Redis 配置 ====================
# 2026-09-27 修正：原 yyc3-45 指向 NAS Redis（仅监听 127.0.0.1 不可达）→ 改 ECS 本机 Redis 7.0.15
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# ==================== 主库配置 ====================
# 与 DB_* 同源（ECS 生产库无独立主从；读扩展规划见核心文档 04/19 号）
MASTER_DB_HOST=127.0.0.1
MASTER_DB_PORT=5433

# ==================== 从库配置 ====================
# 2026-09-27 订正：原 SLAVE_DB_PORT=6399 是 NAS Redis 从库端口，语义错误；

# 完整键集与真实值口径见 deploy/nas/gateway.env.example 与《YYC3-数据库统一架构-2026-09》12 号
